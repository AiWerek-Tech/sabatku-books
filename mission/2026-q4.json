  "activities": [
    {
      "id": "licitar",
      "countryId": "hr",
      "title": "Membuat hati Licitar",
      "kind": "Prakarya",
      "duration": "20–30 menit",
      "adultHelp": true,
      "materials": [
        "Kertas tebal atau karton",
        "Gunting",
        "Spidol atau cat merah dan warna lain"
      ],
      "steps": [
        "Gambar hati berukuran sekitar 10–15 cm pada kertas tebal.",
        "Minta orang dewasa membantu mengguntingnya. Warnai merah dan biarkan kering.",
        "Hias dengan pola berwarna. Tuliskan nama orang yang ingin kamu beri hati itu."
      ],
      "sourcePages": [
        30
      ]
    },
    {
      "id": "flags",
      "countryId": "all",
      "title": "Mewarnai bendera",
      "kind": "Mewarnai",
      "duration": "15–20 menit",
      "adultHelp": false,
      "materials": [
        "Lembar bendera dari sumber",
        "Pensil warna merah, biru, dan kuning"
      ],
      "steps": [
        "Pilih bendera Finlandia, Kroasia, Polandia, atau Britania Raya dari lembar sumber.",
        "Baca petunjuk warna bersama pendamping. Perhatikan letak salib, garis, dan lambangnya.",
        "Temukan negara tersebut pada peta dan baca cerita misinya."
      ],
      "sourcePages": [
        31,
        32
      ]
    },
    {
      "id": "carrots",
      "countryId": "fi",
      "title": "Mengenal porkkanalaatikko",
      "kind": "Memasak bersama",
      "duration": "Sekitar 2 jam",
      "adultHelp": true,
      "materials": [
        "Resep lengkap dari sumber",
        "Beras, susu, wortel, telur, dan bahan lain sesuai resep"
      ],
      "steps": [
        "Baca resep lengkap bersama orang dewasa. Periksa bahan yang sesuai bagi keluarga.",
        "Orang dewasa menangani kompor, pisau, dan oven. Anak dapat membantu mengukur dan mencampur bahan yang sudah aman.",
        "Siapkan nasi, campurkan bahan, lalu panggang sesuai resep. Tunggu hingga cukup dingin sebelum dinikmati."
      ],
      "sourcePages": [
        33
      ]
    },
    {
      "id": "words",
      "countryId": "gb",
      "title": "Satu bahasa, kata yang berbeda",
      "kind": "Permainan bahasa",
      "duration": "10–15 menit",
      "adultHelp": false,
      "materials": [
        "Kertas dan pensil"
      ],
      "steps": [
        "Buat pasangan kartu: truck–lorry, cookie–biscuit, elevator–lift, vacation–holiday, dan flashlight–torch.",
        "Cocokkan kata Inggris Amerika dengan kata Inggris Britania yang bermakna sama.",
        "Ceritakan perbedaan kata yang kamu kenal dalam bahasa atau daerahmu sendiri."
      ],
      "sourcePages": [
        34
      ]
    },
    {
      "id": "pomidor",
      "countryId": "pl",
      "title": "Pomidor: jawablah “tomat”!",
      "kind": "Permainan kelompok",
      "duration": "10–15 menit",
      "adultHelp": true,
      "materials": [
        "Beberapa teman dan pendamping"
      ],
      "steps": [
        "Seorang penanya bergiliran mengajukan pertanyaan yang sopan dan menyenangkan.",
        "Semua jawaban harus “tomat”. Cobalah menjawab tanpa tertawa.",
        "Jika tertawa, lakukan tantangan ringan yang disepakati, seperti menghitung mundur atau menyanyi. Pastikan semua anak nyaman dan boleh berhenti."
      ],
      "sourcePages": [
        34
      ]
    }
  ],
  "preparation": [
    "Baca cerita dan kenali nama serta tempatnya sebelum menyampaikan.",
    "Siapkan foto, peta, dan bahan pendamping yang relevan.",
    "Kenalkan tokoh dan lokasinya, lalu sampaikan cerita dengan jelas.",
    "Hubungkan penutup cerita dengan proyek misi dan ajak kelas berdoa.",
    "Menjelang Sabat ke-13, siapkan kelas untuk Persembahan Sabat Ketiga Belas."
  ],
  "together": [
    "Bacakan dengan tenang dan beri anak kesempatan bertanya.",
    "Untuk anak yang lebih muda, jelaskan nama tempat dan kata yang belum dipahami.",
    "Untuk anak yang lebih besar, ajak mereka menemukan hubungan cerita dengan pelayanan dan kepedulian.",
    "Gunakan Tip Cerita dari sumber untuk menyiapkan penyampaian."
  ],
  "prayer": "Berdoalah bagi tokoh dalam cerita, anak-anak dan keluarga di wilayah ini, serta mereka yang melayani di sana.",
